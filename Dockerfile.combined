# Combined PlanRouter + Computer-Use Agent
# Build:  docker build -f Dockerfile.combined -t facet-combined:latest .
# Run gateway:  docker run -d --name facet-gateway -p 8787:8787 -v ./data:/data facet-combined:latest gateway
# Run agent:    docker run --rm --network host -v ./data:/data facet-combined:latest agent --task "..."

ARG BASE_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
ARG NODE_IMAGE=docker.m.daocloud.io/library/node:22-slim
ARG DSH_VERSION=0.2.2-rc.1
ARG BAILIAN_CLI_VERSION=2.8.3
# Cached Playwright browsers (see docker/playwright-browsers.Dockerfile).
ARG PLAYWRIGHT_BROWSERS_IMAGE=facet-playwright-browsers:v1161

# ---- Use domestic apt mirror (TUNA) ----
FROM ${BASE_IMAGE} AS base
RUN sed -i 's|deb.debian.org|mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list.d/debian.sources \
 && sed -i 's|security.debian.org|mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list.d/debian.sources

# ---- Cached Playwright browsers (copy-only stage) ----
FROM ${PLAYWRIGHT_BROWSERS_IMAGE} AS pw-browsers

# ---- Builder: build PlanRouter wheel ----
FROM base AS builder
USER root
WORKDIR /src
COPY . .
RUN python tools/build_package.py --skip-build \
    && (python -c "import setuptools" || python -m pip install "setuptools>=77") \
    && python -m pip wheel --no-build-isolation --no-deps --wheel-dir /wheels .

# ---- DSH & Bailian CLI (Node tools) ----
FROM ${NODE_IMAGE} AS dsh
ARG DSH_VERSION
ARG BAILIAN_CLI_VERSION
USER root
RUN npm install -g "@deepseek-ai/dsh@${DSH_VERSION}" \
    && npm install --ignore-scripts --prefix /opt/bailian \
       "bailian-cli@${BAILIAN_CLI_VERSION}" \
    && npm cache clean --force

# ---- Final: PlanRouter + Agent ----
FROM base
USER root
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# System deps: PlanRouter + Playwright Chromium
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    fonts-liberation \
    fonts-noto-cjk \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libatspi2.0-0 \
    libcairo2 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libwayland-client0 \
    libx11-6 \
    libxcb1 \
    libxcomposite1 \
    libxcursor1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxi6 \
    libxrandr2 \
    libxrender1 \
    libxss1 \
    libxtst6 \
    xdg-utils \
    && rm -rf /var/lib/apt/lists/*

# User setup (PlanRouter uses 'planrouter', agent uses 'appuser')
# GID 1000 may already exist in base image; find next free GID
RUN if id planrouter >/dev/null 2>&1; then :; \
    elif command -v useradd >/dev/null 2>&1; then \
      groupadd planrouter \
        && useradd -g planrouter --home-dir /data --no-create-home planrouter; \
    else \
      addgroup planrouter \
        && adduser -G planrouter -h /data -D planrouter; \
    fi \
    && APP_GID=$(awk -F: '$3 >= 1000 {print $3}' /etc/group | sort -n | awk 'NR==1{print $1+1} END{if(NR==0) print 1000}') \
    && if id appuser >/dev/null 2>&1; then :; \
       elif command -v useradd >/dev/null 2>&1; then \
         groupadd -g ${APP_GID} appuser \
           && useradd -m -u ${APP_GID} -g ${APP_GID} appuser; \
       else \
         addgroup -g ${APP_GID} appuser \
           && adduser -G appuser -u ${APP_GID} -D appuser; \
       fi \
    && mkdir -p /data /opt/planrouter /app /ms-playwright \
    && chown -R planrouter:planrouter /data /opt/planrouter \
    && chown -R appuser:appuser /app /ms-playwright

# PlanRouter wheel
COPY --from=builder /wheels/ /tmp/wheels/
RUN python -m pip install --no-index --no-cache-dir /tmp/wheels/*.whl \
    && rm -rf /tmp/wheels

# PlanRouter assets
COPY docker/entrypoint.py /opt/planrouter/entrypoint.py
COPY docker/mock_upstream.py /opt/planrouter/mock_upstream.py
COPY docker/router.example.json /opt/planrouter/router.example.json
COPY docs/ /opt/planrouter/docs/
COPY docker/smoke_test.py /opt/planrouter/smoke_test.py
COPY docker/dsh-profile/ /opt/planrouter/dsh-profile/

# Node binaries & DSH
COPY --from=dsh /usr/local/bin/node /usr/local/bin/node
COPY --from=dsh /usr/lib/x86_64-linux-gnu/libstdc++.so.6* /usr/lib/x86_64-linux-gnu/
COPY --from=dsh /usr/local/lib/node_modules/@deepseek-ai /usr/local/lib/node_modules/@deepseek-ai
RUN ln -s ../lib/node_modules/@deepseek-ai/dsh/lib/bin.js /usr/local/bin/dsh \
    && chmod +x /usr/local/bin/dsh \
    && node --version

# Bailian CLI
COPY --from=dsh /opt/bailian /opt/bailian
RUN ln -s /opt/bailian/node_modules/bailian-cli/dist/bailian.mjs /usr/local/bin/bl \
    && chmod +x /opt/bailian/node_modules/bailian-cli/dist/bailian.mjs \
    && bl --version

# Agent Python deps (Playwright). The Chromium build is copied from the cached
# pw-browsers stage instead of downloaded here (the CDN is unreliable behind
# proxy); rebuild that layer with docker/playwright-browsers.Dockerfile.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN pip install --no-cache-dir \
    playwright==1.51.* \
    httpx==0.27.* \
    tenacity==8.*
COPY --from=pw-browsers /ms-playwright/ /ms-playwright/

# Agent code (kept after the Playwright layer so editing it does not trigger
# the ~270MB browser download again).
COPY tools/computer_use_agent.py /app/
COPY src/planrouter /app/src/planrouter
COPY src/facet /app/src/facet

# Agent state lives under /data (script's REPO resolves to /, so profile,
# credentials and run traces default to /data/*). Bind-mount ./data:/data so
# login state, credentials and traces survive container recreation.
# (CJK font ships in the system-deps layer above: without it Chinese UI text
# renders as tofu boxes in screenshots.)

WORKDIR /data

# Expose PlanRouter gateway port
EXPOSE 8787 3080

# Healthcheck for gateway
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8787/', timeout=3)"]

# Entrypoint dispatcher
COPY docker/combined_entrypoint.py /opt/planrouter/combined_entrypoint.py
ENTRYPOINT ["python", "/opt/planrouter/combined_entrypoint.py"]
CMD ["gateway"]